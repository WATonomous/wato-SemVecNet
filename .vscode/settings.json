{
  "cmake.sourceDirectory": "${workspaceFolder}/CUDA-SemVecNet",
  "cmake.buildDirectory": "${workspaceFolder}/CUDA-SemVecNet/build",
  "cmake.generator": "Ninja",
  "cmake.configureOnOpen": false,
  "cmake.configureEnvironment": {
    "CUDACXX": "/opt/cuda/bin/nvcc",
    "CUDA_HOME": "/opt/cuda"
  },
  "cmake.environment": {
    "CUDACXX": "/opt/cuda/bin/nvcc",
    "CUDA_HOME": "/opt/cuda"
  },
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "C_Cpp.default.cppStandard": "c++17",
  "[cpp][cuda-cpp]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false
  },
  "files.associations": {
    "*.cu": "cuda-cpp",
    "*.cuh": "cuda-cpp",
    "*.hpp": "cpp"
  },
  "files.watcherExclude": {
    "**/CUDA-SemVecNet/build/**": true
  }
}
