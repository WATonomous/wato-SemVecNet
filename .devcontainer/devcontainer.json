{
  "name": "SemVecNet CUDA/TensorRT",
  "build": {
    "dockerfile": "../CUDA-SemVecNet/docker/Dockerfile",
    "context": "../CUDA-SemVecNet",
    "target": "dev"
  },
  "runArgs": ["--gpus=all", "--cap-add=SYS_PTRACE", "--security-opt=seccomp=unconfined", "--network=host"],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/wato-SemVecNet,type=bind",
  "workspaceFolder": "/workspaces/wato-SemVecNet",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "nvidia.nsight-vscode-edition"
      ]
    }
  },
  "postCreateCommand": "nvcc --version && ls ${TensorRT_Inc}/NvInfer.h"
}
